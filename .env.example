# Application Config
ENVIRONMENT=development
LOG_LEVEL=INFO
API_KEY=whipstitch-dev-key-12345
TENANT_DEFAULT_ID=trifid_media

# Database Configuration (PostgreSQL)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=whipstitch_db
POSTGRES_USER=whipstitch_user
POSTGRES_PASSWORD=whipstitch_password
DATABASE_URL=postgresql+asyncpg://whipstitch_user:whipstitch_password@postgres:5432/whipstitch_db

# Cache & Lock Configuration (Redis)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Workflow Orchestration (Temporal)
TEMPORAL_HOST=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=whipstitch-inbound-queue

# LLM Providers — real keys enable AI generation (battlecards, MEDDPICC, meeting prep).
# Any key containing "mock" is treated as absent and the deterministic template path is used.
# Gemini: aistudio.google.com/apikey   Groq: console.groq.com/keys
GEMINI_API_KEY=mock-gemini-key
GROQ_API_KEY=mock-groq-key
OPENAI_API_KEY=mock-openai-key

# Discovery & Research
SERPER_API_KEY=mock-serper-key         # serper.dev — free tier, powers hiring-signal discovery + company signals

# Enrichment & CRM Integrations
HUBSPOT_SANDBOX_API_KEY=mock-hubspot-key
APOLLO_API_KEY=mock-apollo-key
MOCK_APOLLO=true                        # set false ONLY with a real Apollo key (50 credits/month hard cap)

# Auth & Encryption — MUST be replaced with random secrets in production
JWT_SECRET_KEY=change-me-to-a-long-random-string
ENCRYPTION_MASTER_KEY=change-me-32-url-safe-base64-bytes

# Alerting
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/mock/webhook/test
